//! [cmakebuild]
    \code
    find_package(Qt6 REQUIRED COMPONENTS Lego)
    target_link_libraries(mytarget PRIVATE Qt6::Lego)
    \endcode
//! [cmakebuild]

//! [qmakebuild]
    \code
    QT += lego
    \endcode
//! [qmakebuild]
